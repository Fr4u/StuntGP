include_guard(GLOBAL)
if(NOT TARGET project_options)
  message(FATAL_ERROR "audio output matrix requires project_options")
endif()
add_library(audio_output_matrix INTERFACE)
target_link_libraries(audio_output_matrix INTERFACE project_options)
if(BUILD_TESTING)
  add_executable(audio_output_matrix_tests "${PROJECT_SOURCE_DIR}/tests/audio_output_matrix_tests.cpp")
  target_link_libraries(audio_output_matrix_tests PRIVATE audio_output_matrix)
  add_test(NAME audio_output_matrix_cpu COMMAND audio_output_matrix_tests)
  if(WIN32)
    add_executable(audio_output_matrix_sdk_tests "${PROJECT_SOURCE_DIR}/tests/audio_output_matrix_sdk_tests.cpp")
    target_link_libraries(audio_output_matrix_sdk_tests PRIVATE audio_output_matrix)
    add_test(NAME audio_output_matrix_sdk_fake COMMAND audio_output_matrix_sdk_tests)
  endif()
endif()
