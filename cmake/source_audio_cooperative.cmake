include_guard(GLOBAL)
if(NOT WIN32 OR NOT SGN_BUILD_RUNTIME)
  return()
endif()
foreach(required platform_audio race_session source_audio_default_device)
  if(NOT TARGET ${required})
    message(FATAL_ERROR "source audio cooperative requires integrated ${required}")
  endif()
endforeach()
add_library(source_audio_cooperative STATIC "${PROJECT_SOURCE_DIR}/src/source_audio_cooperative.cpp")
target_link_libraries(source_audio_cooperative PUBLIC source_audio_default_device)
add_library(source_audio_cooperative_platform STATIC "${PROJECT_SOURCE_DIR}/src/source_audio_cooperative_platform.cpp")
target_link_libraries(source_audio_cooperative_platform PUBLIC source_audio_cooperative race_session)
if(BUILD_TESTING)
  add_executable(source_audio_cooperative_tests "${PROJECT_SOURCE_DIR}/tests/source_audio_cooperative_tests.cpp")
  target_link_libraries(source_audio_cooperative_tests PRIVATE source_audio_cooperative)
  add_test(NAME source_audio_cooperative_abi_receiving COMMAND source_audio_cooperative_tests)
  set_tests_properties(source_audio_cooperative_abi_receiving PROPERTIES RUN_SERIAL TRUE TIMEOUT 30)
  #No automatic OS test creates/selects a HWND. Main's existing same-process,
  #same-thread window fixture calls the explicitly supplied-HWND receiving API.
  add_library(source_audio_cooperative_os_receiving STATIC "${PROJECT_SOURCE_DIR}/tests/source_audio_cooperative_os_receiving.cpp")
  target_include_directories(source_audio_cooperative_os_receiving PUBLIC "${PROJECT_SOURCE_DIR}/tests")
  target_link_libraries(source_audio_cooperative_os_receiving PUBLIC source_audio_cooperative_platform)
endif()
