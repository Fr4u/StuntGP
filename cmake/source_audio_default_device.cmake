#A2 composes after sealed A1 enumeration and the deferred platform bootstrap.
include_guard(GLOBAL)
if(NOT WIN32 OR NOT SGN_BUILD_RUNTIME)
  return()
endif()
foreach(required platform_audio race_session source_audio_enumeration)
  if(NOT TARGET ${required})
    message(FATAL_ERROR "source default device requires integrated ${required}")
  endif()
endforeach()
#The actual creation import lives in the SAME existing platform_audio unit.
target_link_libraries(platform_audio PUBLIC dsound)
add_library(source_audio_default_device STATIC "${PROJECT_SOURCE_DIR}/src/source_audio_default_device.cpp")
target_link_libraries(source_audio_default_device PUBLIC platform_audio source_audio_enumeration)
add_library(source_audio_default_device_session STATIC "${PROJECT_SOURCE_DIR}/src/source_audio_default_device_session.cpp")
target_link_libraries(source_audio_default_device_session PUBLIC race_session source_audio_default_device)
if(BUILD_TESTING)
  add_executable(source_audio_default_device_tests "${PROJECT_SOURCE_DIR}/tests/source_audio_default_device_tests.cpp")
  target_link_libraries(source_audio_default_device_tests PRIVATE source_audio_default_device)
  add_test(NAME source_audio_default_device_abi_receiving COMMAND source_audio_default_device_tests --abi)
  add_test(NAME source_audio_default_device_os_receiving COMMAND source_audio_default_device_tests --os)
  add_test(NAME source_audio_default_device_preview_receiving COMMAND source_audio_default_device_tests --preview)
  add_test(NAME source_audio_default_device_foreign_destroy_receiving COMMAND source_audio_default_device_tests --foreign-destroy)
  set_tests_properties(source_audio_default_device_abi_receiving source_audio_default_device_os_receiving source_audio_default_device_preview_receiving
    source_audio_default_device_foreign_destroy_receiving PROPERTIES RUN_SERIAL TRUE TIMEOUT 30)
  add_executable(source_audio_default_device_session_tests "${PROJECT_SOURCE_DIR}/tests/source_audio_default_device_session_tests.cpp")
  target_link_libraries(source_audio_default_device_session_tests PRIVATE source_audio_default_device_session)
  add_test(NAME source_audio_default_device_session_receiving COMMAND source_audio_default_device_session_tests)
  set_tests_properties(source_audio_default_device_session_receiving PROPERTIES RUN_SERIAL TRUE TIMEOUT 30)
endif()
