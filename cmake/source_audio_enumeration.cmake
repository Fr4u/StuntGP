# Include after the existing core/platform/session target declarations.
include_guard(GLOBAL)
if(NOT TARGET retail_audio_startup)
  message(FATAL_ERROR "source audio enumeration requires the existing startup owner")
endif()
add_library(source_audio_enumeration STATIC "${PROJECT_SOURCE_DIR}/src/source_audio_enumeration.cpp")
target_link_libraries(source_audio_enumeration PUBLIC retail_audio_startup)
if(BUILD_TESTING)
  add_executable(source_audio_enumeration_tests "${PROJECT_SOURCE_DIR}/tests/source_audio_enumeration_tests.cpp")
  target_link_libraries(source_audio_enumeration_tests PRIVATE source_audio_enumeration)
  add_test(NAME source_audio_enumeration_receiving COMMAND source_audio_enumeration_tests)
endif()
if(WIN32)
  add_library(source_audio_enumeration_native STATIC "${PROJECT_SOURCE_DIR}/src/source_audio_enumeration_native.cpp")
  target_link_libraries(source_audio_enumeration_native PUBLIC retail_audio_startup dsound)
  if(TARGET platform_audio)
    #The existing bridge now calls the actual import; downstream consumers need
    #this implementation and import library. There is no reverse dependency.
    target_link_libraries(platform_audio PUBLIC source_audio_enumeration_native)
  endif()
  if(TARGET race_session)
    add_library(source_audio_enumeration_session STATIC "${PROJECT_SOURCE_DIR}/src/source_audio_enumeration_session.cpp")
    target_link_libraries(source_audio_enumeration_session PUBLIC race_session source_audio_enumeration source_audio_enumeration_native)
  endif()
  if(BUILD_TESTING)
    add_executable(source_audio_enumeration_native_tests "${PROJECT_SOURCE_DIR}/tests/source_audio_enumeration_native_tests.cpp")
    target_link_libraries(source_audio_enumeration_native_tests PRIVATE source_audio_enumeration source_audio_enumeration_native)
    add_test(NAME source_audio_enumeration_abi_receiving COMMAND source_audio_enumeration_native_tests --abi)
    add_test(NAME source_audio_enumeration_os_receiving COMMAND source_audio_enumeration_native_tests --os)
    set_tests_properties(source_audio_enumeration_abi_receiving source_audio_enumeration_os_receiving PROPERTIES RUN_SERIAL TRUE TIMEOUT 30)
    set_tests_properties(source_audio_enumeration_os_receiving PROPERTIES SKIP_RETURN_CODE 77)
  endif()
endif()
