include_guard(GLOBAL)
if(NOT WIN32 OR NOT SGN_BUILD_RUNTIME)
  return()
endif()
foreach(required platform_audio race_session source_audio_primary_format)
  if(NOT TARGET ${required})
    message(FATAL_ERROR "source listener acquisition requires integrated ${required}")
  endif()
endforeach()
add_library(source_audio_listener_acquisition STATIC "${PROJECT_SOURCE_DIR}/src/source_audio_listener_acquisition.cpp")
target_link_libraries(source_audio_listener_acquisition PUBLIC source_audio_primary_format)
add_library(source_audio_listener_acquisition_platform STATIC "${PROJECT_SOURCE_DIR}/src/source_audio_listener_acquisition_platform.cpp")
target_link_libraries(source_audio_listener_acquisition_platform PUBLIC source_audio_listener_acquisition race_session)
if(BUILD_TESTING)
  add_executable(source_audio_listener_acquisition_tests "${PROJECT_SOURCE_DIR}/tests/source_audio_listener_acquisition_tests.cpp")
  target_link_libraries(source_audio_listener_acquisition_tests PRIVATE source_audio_listener_acquisition)
  add_test(NAME source_audio_listener_acquisition_abi_receiving COMMAND source_audio_listener_acquisition_tests)
  add_test(NAME source_audio_listener_acquisition_foreign_destroy_receiving COMMAND source_audio_listener_acquisition_tests --foreign-destroy-listener)
  set_tests_properties(source_audio_listener_acquisition_abi_receiving source_audio_listener_acquisition_foreign_destroy_receiving PROPERTIES RUN_SERIAL TRUE TIMEOUT 30)
  #Compiled only here; Main alone executes this on the existing A5 platform/window.
  add_library(source_audio_listener_acquisition_os_receiving STATIC "${PROJECT_SOURCE_DIR}/tests/source_audio_listener_acquisition_os_receiving.cpp")
  target_include_directories(source_audio_listener_acquisition_os_receiving PUBLIC "${PROJECT_SOURCE_DIR}/tests")
  target_link_libraries(source_audio_listener_acquisition_os_receiving PUBLIC source_audio_listener_acquisition_platform)
endif()
