include_guard(GLOBAL)
if(NOT WIN32 OR NOT SGN_BUILD_RUNTIME)
  return()
endif()
foreach(required platform_audio race_session source_audio_listener_acquisition source_audio_listener_configuration)
  if(NOT TARGET ${required})
    message(FATAL_ERROR "native listener configuration requires integrated ${required}")
  endif()
endforeach()
target_link_libraries(platform_audio PUBLIC source_audio_listener_configuration)
add_library(source_audio_listener_native_configuration STATIC "${PROJECT_SOURCE_DIR}/src/source_audio_listener_native_configuration.cpp")
target_link_libraries(source_audio_listener_native_configuration PUBLIC source_audio_listener_acquisition)
add_library(source_audio_listener_native_configuration_platform STATIC "${PROJECT_SOURCE_DIR}/src/source_audio_listener_native_configuration_platform.cpp")
target_link_libraries(source_audio_listener_native_configuration_platform PUBLIC source_audio_listener_native_configuration race_session)
if(BUILD_TESTING)
  add_executable(source_audio_listener_native_configuration_tests "${PROJECT_SOURCE_DIR}/tests/source_audio_listener_native_configuration_tests.cpp")
  target_link_libraries(source_audio_listener_native_configuration_tests PRIVATE source_audio_listener_native_configuration)
  add_test(NAME source_audio_listener_native_configuration_abi_receiving COMMAND source_audio_listener_native_configuration_tests)
  set_tests_properties(source_audio_listener_native_configuration_abi_receiving PROPERTIES RUN_SERIAL TRUE TIMEOUT 30)
  #Main alone executes the supplied existing-window receiving function.
  add_library(source_audio_listener_native_configuration_os_receiving STATIC "${PROJECT_SOURCE_DIR}/tests/source_audio_listener_native_configuration_os_receiving.cpp")
  target_include_directories(source_audio_listener_native_configuration_os_receiving PUBLIC "${PROJECT_SOURCE_DIR}/tests")
  target_link_libraries(source_audio_listener_native_configuration_os_receiving PUBLIC source_audio_listener_native_configuration_platform)
endif()
