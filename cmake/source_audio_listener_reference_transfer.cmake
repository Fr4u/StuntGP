include_guard(GLOBAL)
if(NOT WIN32 OR NOT SGN_BUILD_RUNTIME OR NOT BUILD_TESTING)
  return()
endif()
if(NOT TARGET source_audio_listener_native_configuration)
  message(FATAL_ERROR "listener reference transfer tests require native listener configuration")
endif()
add_executable(source_audio_listener_reference_transfer_tests "${PROJECT_SOURCE_DIR}/tests/source_audio_listener_reference_transfer_tests.cpp")
target_link_libraries(source_audio_listener_reference_transfer_tests PRIVATE source_audio_listener_native_configuration)
add_test(NAME source_audio_listener_reference_transfer_cpu COMMAND source_audio_listener_reference_transfer_tests)
add_executable(source_audio_listener_composition_probe "${PROJECT_SOURCE_DIR}/tests/source_audio_listener_composition_probe.cpp")
target_link_libraries(source_audio_listener_composition_probe PRIVATE source_audio_listener_native_configuration)
foreach(case observe success failure exception)
  add_test(NAME source_audio_listener_composition_${case} COMMAND source_audio_listener_composition_probe ${case})
  set_tests_properties(source_audio_listener_composition_${case} PROPERTIES RUN_SERIAL TRUE TIMEOUT 30)
endforeach()
set_tests_properties(source_audio_listener_reference_transfer_cpu PROPERTIES RUN_SERIAL TRUE TIMEOUT 30)
