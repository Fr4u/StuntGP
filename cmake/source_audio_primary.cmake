include_guard(GLOBAL)
if(NOT WIN32 OR NOT SGN_BUILD_RUNTIME)
  return()
endif()
foreach(required platform_audio race_session source_audio_cooperative)
  if(NOT TARGET ${required})
    message(FATAL_ERROR "source audio primary requires integrated ${required}")
  endif()
endforeach()
add_library(source_audio_primary STATIC "${PROJECT_SOURCE_DIR}/src/source_audio_primary.cpp")
target_link_libraries(source_audio_primary PUBLIC source_audio_cooperative)
add_library(source_audio_primary_platform STATIC "${PROJECT_SOURCE_DIR}/src/source_audio_primary_platform.cpp")
target_link_libraries(source_audio_primary_platform PUBLIC source_audio_primary race_session)
if(BUILD_TESTING)
  add_executable(source_audio_primary_tests "${PROJECT_SOURCE_DIR}/tests/source_audio_primary_tests.cpp")
  target_link_libraries(source_audio_primary_tests PRIVATE source_audio_primary)
  add_test(NAME source_audio_primary_abi_receiving COMMAND source_audio_primary_tests)
  add_test(NAME source_audio_primary_foreign_destroy_receiving COMMAND source_audio_primary_tests --foreign-destroy-primary)
  set_tests_properties(source_audio_primary_abi_receiving source_audio_primary_foreign_destroy_receiving PROPERTIES RUN_SERIAL TRUE TIMEOUT 30)
  #Main supplies the same actual A2/A3 platform and live window chain.
  add_library(source_audio_primary_os_receiving STATIC "${PROJECT_SOURCE_DIR}/tests/source_audio_primary_os_receiving.cpp")
  target_include_directories(source_audio_primary_os_receiving PUBLIC "${PROJECT_SOURCE_DIR}/tests")
  target_link_libraries(source_audio_primary_os_receiving PUBLIC source_audio_primary_platform)
endif()
