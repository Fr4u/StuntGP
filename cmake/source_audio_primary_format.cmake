include_guard(GLOBAL)
if(NOT WIN32 OR NOT SGN_BUILD_RUNTIME)
  return()
endif()
foreach(required platform_audio race_session source_audio_primary)
  if(NOT TARGET ${required})
    message(FATAL_ERROR "source primary format requires integrated ${required}")
  endif()
endforeach()
add_library(source_audio_primary_format STATIC "${PROJECT_SOURCE_DIR}/src/source_audio_primary_format.cpp")
target_link_libraries(source_audio_primary_format PUBLIC source_audio_primary)
add_library(source_audio_primary_format_platform STATIC "${PROJECT_SOURCE_DIR}/src/source_audio_primary_format_platform.cpp")
target_link_libraries(source_audio_primary_format_platform PUBLIC source_audio_primary_format race_session)
if(BUILD_TESTING)
  add_executable(source_audio_primary_format_tests "${PROJECT_SOURCE_DIR}/tests/source_audio_primary_format_tests.cpp")
  target_link_libraries(source_audio_primary_format_tests PRIVATE source_audio_primary_format)
  add_test(NAME source_audio_primary_format_abi_receiving COMMAND source_audio_primary_format_tests)
  set_tests_properties(source_audio_primary_format_abi_receiving PROPERTIES RUN_SERIAL TRUE TIMEOUT 30)
  add_library(source_audio_primary_format_os_receiving STATIC "${PROJECT_SOURCE_DIR}/tests/source_audio_primary_format_os_receiving.cpp")
  target_include_directories(source_audio_primary_format_os_receiving PUBLIC "${PROJECT_SOURCE_DIR}/tests")
  target_link_libraries(source_audio_primary_format_os_receiving PUBLIC source_audio_primary_format_platform)
endif()
