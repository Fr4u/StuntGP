include_guard(GLOBAL)
if(NOT WIN32 OR NOT SGN_BUILD_RUNTIME)
  return()
endif()
foreach(required platform_audio race_session source_audio_listener_native_configuration retail_audio_startup)
  if(NOT TARGET ${required})
    message(FATAL_ERROR "native sample creator requires integrated ${required}")
  endif()
endforeach()
add_library(source_audio_sample_creator STATIC "${PROJECT_SOURCE_DIR}/src/source_audio_sample_creator.cpp")
target_link_libraries(source_audio_sample_creator PUBLIC source_audio_listener_native_configuration)
add_library(source_audio_sample_creator_platform STATIC "${PROJECT_SOURCE_DIR}/src/source_audio_sample_creator_platform.cpp")
target_link_libraries(source_audio_sample_creator_platform PUBLIC source_audio_sample_creator race_session)
if(BUILD_TESTING)
  add_executable(source_audio_sample_creator_tests "${PROJECT_SOURCE_DIR}/tests/source_audio_sample_creator_tests.cpp")
  target_link_libraries(source_audio_sample_creator_tests PRIVATE source_audio_sample_creator)
  add_test(NAME source_audio_sample_creator_abi_receiving COMMAND source_audio_sample_creator_tests)
  add_test(NAME source_audio_sample_creator_foreign_destroy_receiving
    COMMAND source_audio_sample_creator_tests --foreign-destroy-sample)
  set_tests_properties(source_audio_sample_creator_abi_receiving source_audio_sample_creator_foreign_destroy_receiving
    PROPERTIES RUN_SERIAL TRUE TIMEOUT 45)
endif()
