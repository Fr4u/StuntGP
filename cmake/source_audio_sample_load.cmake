include_guard(GLOBAL)
if(NOT WIN32 OR NOT SGN_BUILD_RUNTIME)
  return()
endif()
foreach(required platform_audio race_session source_audio_sample_creator retail_audio_startup)
  if(NOT TARGET ${required})
    message(FATAL_ERROR "native sample load requires integrated ${required}")
  endif()
endforeach()
add_library(source_audio_sample_load STATIC "${PROJECT_SOURCE_DIR}/src/source_audio_sample_load.cpp")
target_link_libraries(source_audio_sample_load PUBLIC source_audio_sample_creator)
add_library(source_audio_sample_load_platform STATIC "${PROJECT_SOURCE_DIR}/src/source_audio_sample_load_platform.cpp")
target_link_libraries(source_audio_sample_load_platform PUBLIC source_audio_sample_load race_session)
if(BUILD_TESTING)
  set(SGN_SAMPLE_LOAD_RETAIL_ROOT "${PROJECT_SOURCE_DIR}/data/retail" CACHE PATH "Retail assets for single native sample receiving")
  add_executable(source_audio_sample_load_tests "${PROJECT_SOURCE_DIR}/tests/source_audio_sample_load_tests.cpp")
  target_link_libraries(source_audio_sample_load_tests PRIVATE source_audio_sample_load)
  add_test(NAME source_audio_sample_load_abi_receiving COMMAND source_audio_sample_load_tests "${SGN_SAMPLE_LOAD_RETAIL_ROOT}")
  set_tests_properties(source_audio_sample_load_abi_receiving PROPERTIES RUN_SERIAL TRUE TIMEOUT 60)
endif()
