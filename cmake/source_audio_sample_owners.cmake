include_guard(GLOBAL)
if(BUILD_TESTING)
  if(NOT TARGET retail_audio_startup)
    message(FATAL_ERROR "sample owner tests require the existing retail_audio_startup target")
  endif()
  set(SGN_SAMPLE_OWNER_RETAIL_ROOT "${PROJECT_SOURCE_DIR}/data/retail" CACHE PATH "Retail assets for sample owner CPU tests")
  add_executable(audio_sample_loading_reentry "${PROJECT_SOURCE_DIR}/tests/audio_sample_loading_reentry.cpp")
  target_link_libraries(audio_sample_loading_reentry PRIVATE retail_audio_startup)
  foreach(case IN ITEMS lock mode device)
    add_test(NAME source_audio_sample_owner_${case} COMMAND audio_sample_loading_reentry "${case}" "${SGN_SAMPLE_OWNER_RETAIL_ROOT}")
  endforeach()
  add_executable(audio_sample_payload_extent "${PROJECT_SOURCE_DIR}/tests/audio_sample_payload_extent.cpp")
  target_link_libraries(audio_sample_payload_extent PRIVATE retail_audio_startup)
  foreach(case IN ITEMS equal over failed_lock short_first)
    add_test(NAME source_audio_sample_extent_${case} COMMAND audio_sample_payload_extent "${case}" "${SGN_SAMPLE_OWNER_RETAIL_ROOT}")
  endforeach()
endif()
