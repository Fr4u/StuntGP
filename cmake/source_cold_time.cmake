# Private candidate. Main integrates after race_session and source_random_seed.
# No automatic source parent/cold-start hook. Seed dependency is the sealed parent proposal.
include_guard(GLOBAL)
if(NOT TARGET source_random_seed OR NOT TARGET race_session)
  message(FATAL_ERROR "Integrate source_random_seed and race_session before source_cold_time")
endif()
add_library(source_cold_time STATIC "${PROJECT_SOURCE_DIR}/src/source_cold_time.cpp")
target_include_directories(source_cold_time PUBLIC "${PROJECT_SOURCE_DIR}/include")
target_link_libraries(source_cold_time PUBLIC project_options source_random_seed)
add_library(source_cold_time_session STATIC "${PROJECT_SOURCE_DIR}/src/source_cold_time_session.cpp")
target_link_libraries(source_cold_time_session PUBLIC source_cold_time race_session)
if(WIN32)
  add_library(source_cold_time_win32 STATIC "${PROJECT_SOURCE_DIR}/src/source_cold_time_win32.cpp")
  target_link_libraries(source_cold_time_win32 PUBLIC source_cold_time PRIVATE kernel32)
endif()
if(BUILD_TESTING)
  add_executable(source_cold_time_tests "${PROJECT_SOURCE_DIR}/tests/source_cold_time_tests.cpp")
  target_link_libraries(source_cold_time_tests PRIVATE source_cold_time)
  add_test(NAME source_cold_time_receiving COMMAND source_cold_time_tests)
endif()
