# Authored receiving only. Main opts in after importing the exact bank core
# and this proposal. No producer initialization is hidden in a constructor.
include_guard(GLOBAL)
option(SGN_BUILD_SOURCE_FONT_BANK_RECEIVING "Build explicit source-font bank receiving" OFF)
if(SGN_BUILD_SOURCE_FONT_BANK_RECEIVING)
  if(NOT TARGET source_allocation_bank)
    message(FATAL_ERROR "Source font receiving requires the separately qualified source_allocation_bank target")
  endif()
  set(SGN_SOURCE_FONT_CORPUS "${PROJECT_SOURCE_DIR}/reports/contact-work/series6/font-resources/native-v2/font-corpus.bin" CACHE FILEPATH "Pinned source font corpus")
  set(SGN_SOURCE_FONT_RETAIL_ROOT "${PROJECT_SOURCE_DIR}/data/retail" CACHE PATH "Actual NEW retail data root")
  if(NOT EXISTS "${SGN_SOURCE_FONT_CORPUS}" OR NOT EXISTS "${SGN_SOURCE_FONT_RETAIL_ROOT}/wads/fonts.wad")
    message(FATAL_ERROR "Source font receiving needs the actual corpus and fonts.wad")
  endif()
  add_executable(source_font_bank_oracle tests/source_font_bank_oracle.cpp)
  target_link_libraries(source_font_bank_oracle PRIVATE retail_font_resources retail_material_filesystem)
  add_test(NAME source_font_bank_original_corpus COMMAND source_font_bank_oracle "${SGN_SOURCE_FONT_CORPUS}" "${SGN_SOURCE_FONT_RETAIL_ROOT}")
  add_executable(source_font_bank_lifetime tests/source_font_bank_lifetime.cpp)
  target_link_libraries(source_font_bank_lifetime PRIVATE retail_font_resources retail_material_filesystem)
  foreach(font_case IN ITEMS uninitialized missing_file invalid_format short_read first_upload second_upload observer_abort disabled scope_and_owner high_ordinal scratch_null nested_null mode_and_bank)
    add_test(NAME source_font_bank_${font_case} COMMAND source_font_bank_lifetime "${font_case}" "${SGN_SOURCE_FONT_RETAIL_ROOT}")
  endforeach()
  option(SGN_BUILD_SOURCE_FONT_BANK_GPU_RECEIVING "Build the explicit source-font real GPU receiver; never registers an automatic GPU run" OFF)
  if(SGN_BUILD_SOURCE_FONT_BANK_GPU_RECEIVING)
    add_executable(source_font_bank_d3d12 tests/source_font_bank_d3d12.cpp)
    target_link_libraries(source_font_bank_d3d12 PRIVATE font_material_d3d12 material_texture_replacement retail_material_filesystem)
  endif()
endif()
