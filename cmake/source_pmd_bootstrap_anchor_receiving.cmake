include_guard(GLOBAL)
option(SGN_BUILD_SOURCE_PMD_BOOTSTRAP_ANCHOR_RECEIVING "Build canonical bootstrap anchor consumer receiving" OFF)
if(SGN_BUILD_SOURCE_PMD_BOOTSTRAP_ANCHOR_RECEIVING)
  set(SGN_SOURCE_PMD_RETAIL_ROOT "${PROJECT_SOURCE_DIR}/data/retail" CACHE PATH "Actual NEW retail data")
  set(SGN_SOURCE_PMD_ANCHOR_CORPUS "${PROJECT_SOURCE_DIR}/reports/series2/vehicle-anchors/retail-vehicle-anchors-corpus.bin" CACHE FILEPATH "Original anchor corpus")
  set(SGN_SOURCE_PMD_ANCHOR_PROBE_DIR "${PROJECT_SOURCE_DIR}/reports/level-work/vehicle-anchors" CACHE PATH "Original anchor reader probes")
  set(SGN_SOURCE_PMD_BOOTSTRAP_CORPUS "${PROJECT_SOURCE_DIR}/reports/level-work/vehicle-bootstrap/full/bootstrap-corpus.bin" CACHE FILEPATH "Original bootstrap corpus")
  foreach(reader IN ITEMS source_pmd_current_anchor_oracle source_pmd_bootstrap_oracle source_pmd_bootstrap_anchor_contracts)
    add_executable(${reader} "${PROJECT_SOURCE_DIR}/tests/${reader}.cpp")
    target_link_libraries(${reader} PRIVATE retail_vehicle_bootstrap source_pmd_geometry)
  endforeach()
  foreach(corpus IN ITEMS SGN_SOURCE_PMD_ANCHOR_CORPUS SGN_SOURCE_PMD_BOOTSTRAP_CORPUS)
    if(NOT EXISTS "${${corpus}}")
      message(FATAL_ERROR "Missing immutable corpus: ${corpus}")
    endif()
  endforeach()
  add_test(NAME current_anchor_original COMMAND source_pmd_current_anchor_oracle "${SGN_SOURCE_PMD_ANCHOR_CORPUS}" "${SGN_SOURCE_PMD_RETAIL_ROOT}")
  add_test(NAME bootstrap_original COMMAND source_pmd_bootstrap_oracle "${SGN_SOURCE_PMD_BOOTSTRAP_CORPUS}" "${SGN_SOURCE_PMD_RETAIL_ROOT}")
  foreach(probe IN ITEMS wrong_anchor_expected wrong_W_expected wrong_unowned_expected truncated trailing empty unknown_operation invalid_null_mask invalid_current)
    if(NOT EXISTS "${SGN_SOURCE_PMD_ANCHOR_PROBE_DIR}/${probe}.probe.bin")
      message(FATAL_ERROR "Missing original anchor probe: ${probe}")
    endif()
    add_test(NAME current_anchor_reject_${probe} COMMAND source_pmd_current_anchor_oracle "${SGN_SOURCE_PMD_ANCHOR_PROBE_DIR}/${probe}.probe.bin" "${SGN_SOURCE_PMD_RETAIL_ROOT}")
    set_tests_properties(current_anchor_reject_${probe} PROPERTIES WILL_FAIL TRUE)
  endforeach()
  foreach(contract IN ITEMS current_alias ordering lifetime six_slot_chain views)
    add_test(NAME bootstrap_anchor_${contract} COMMAND source_pmd_bootstrap_anchor_contracts "${contract}" "${SGN_SOURCE_PMD_RETAIL_ROOT}")
  endforeach()
endif()
