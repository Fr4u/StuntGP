include_guard(GLOBAL)
option(SGN_BUILD_SOURCE_PMD_BRAKE_EFFECTS_RECEIVING "Build canonical brake effects receiving" OFF)
if(SGN_BUILD_SOURCE_PMD_BRAKE_EFFECTS_RECEIVING)
  set(SGN_SOURCE_PMD_RETAIL_ROOT "${PROJECT_SOURCE_DIR}/data/retail" CACHE PATH "Actual retail data")
  set(SGN_SOURCE_PMD_MODEL_EFFECTS_CORPUS "${PROJECT_SOURCE_DIR}/reports/camera-work/series2/model-effects/model-effects.dat" CACHE FILEPATH "Immutable model effects corpus")
  set(SGN_SOURCE_PMD_BRAKE_EFFECTS_PROBES "${PROJECT_SOURCE_DIR}/reports/platform-work/series6/source-pmd-brake-effects-owner-v1/probes" CACHE PATH "Reader probes")
  foreach(reader IN ITEMS source_pmd_brake_effects_oracle source_pmd_brake_effects_contracts)
    add_executable(${reader} "${PROJECT_SOURCE_DIR}/tests/${reader}.cpp")
    target_link_libraries(${reader} PRIVATE vehicle_model_effects)
  endforeach()
  add_test(NAME brake_effects_owner_original256 COMMAND source_pmd_brake_effects_oracle "${SGN_SOURCE_PMD_MODEL_EFFECTS_CORPUS}" "${SGN_SOURCE_PMD_RETAIL_ROOT}")
  foreach(probe IN ITEMS valid_first valid_shared bad_signature truncated trailing empty unknown_operation no_selected invalid_step invalid_lod invalid_rawmap invalid_transform invalid_attributes wrong_scalar wrong_unowned)
    if(NOT EXISTS "${SGN_SOURCE_PMD_BRAKE_EFFECTS_PROBES}/${probe}.dat")
      message(FATAL_ERROR "Missing brake effects probe: ${probe}")
    endif()
    add_test(NAME brake_effects_owner_probe_${probe} COMMAND source_pmd_brake_effects_oracle "${SGN_SOURCE_PMD_BRAKE_EFFECTS_PROBES}/${probe}.dat" "${SGN_SOURCE_PMD_RETAIL_ROOT}")
    if(NOT probe MATCHES "^valid_")
      set_tests_properties(brake_effects_owner_probe_${probe} PROPERTIES WILL_FAIL TRUE)
    endif()
  endforeach()
  foreach(contract IN ITEMS retail40 alias_order current_preamble inactive_pointers guard_prefix lifetime)
    add_test(NAME brake_effects_owner_contract_${contract} COMMAND source_pmd_brake_effects_contracts "${contract}" "${SGN_SOURCE_PMD_RETAIL_ROOT}")
  endforeach()
endif()
