include_guard(GLOBAL)
option(SGN_BUILD_SOURCE_PMD_BRAKE_LIGHTS_RECEIVING "Build canonical brake lights consumer receiving" OFF)
if(SGN_BUILD_SOURCE_PMD_BRAKE_LIGHTS_RECEIVING)
  set(SGN_SOURCE_PMD_RETAIL_ROOT "${PROJECT_SOURCE_DIR}/data/retail" CACHE PATH "Actual NEW retail data")
  set(SGN_SOURCE_PMD_MODEL_EFFECTS_CORPUS "${PROJECT_SOURCE_DIR}/reports/camera-work/series2/model-effects/model-effects.dat" CACHE FILEPATH "Immutable original ModelFX corpus")
  set(SGN_SOURCE_PMD_BRAKE_PROBE_DIR "${PROJECT_SOURCE_DIR}/reports/platform-work/series6/source-pmd-brake-lights-owner-v1/probes" CACHE PATH "Authored brake reader probes")
  foreach(reader IN ITEMS source_pmd_brake_lights_oracle source_pmd_brake_lights_contracts)
    add_executable(${reader} "${PROJECT_SOURCE_DIR}/tests/${reader}.cpp")
    target_link_libraries(${reader} PRIVATE vehicle_model_effects)
  endforeach()
  if(NOT EXISTS "${SGN_SOURCE_PMD_MODEL_EFFECTS_CORPUS}")
    message(FATAL_ERROR "Missing immutable ModelFX corpus")
  endif()
  add_test(NAME brake_lights_original_projection COMMAND source_pmd_brake_lights_oracle "${SGN_SOURCE_PMD_MODEL_EFFECTS_CORPUS}" "${SGN_SOURCE_PMD_RETAIL_ROOT}")
  foreach(probe IN ITEMS valid_single bad_magic truncated trailing empty no_selected invalid_op invalid_lod invalid_map invalid_attrspan wrong_scalar wrong_unowned wrong_flag)
    if(NOT EXISTS "${SGN_SOURCE_PMD_BRAKE_PROBE_DIR}/${probe}.dat")
      message(FATAL_ERROR "Missing authored brake probe: ${probe}")
    endif()
    add_test(NAME brake_probe_${probe} COMMAND source_pmd_brake_lights_oracle "${SGN_SOURCE_PMD_BRAKE_PROBE_DIR}/${probe}.dat" "${SGN_SOURCE_PMD_RETAIL_ROOT}")
    if(NOT probe STREQUAL "valid_single")
      set_tests_properties(brake_probe_${probe} PROPERTIES WILL_FAIL TRUE)
    endif()
  endforeach()
  foreach(contract IN ITEMS retail40 alias_pointer order_gates lifetime)
    add_test(NAME brake_contract_${contract} COMMAND source_pmd_brake_lights_contracts "${contract}" "${SGN_SOURCE_PMD_RETAIL_ROOT}")
  endforeach()
endif()
