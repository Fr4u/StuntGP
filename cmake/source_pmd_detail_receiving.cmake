# Original-corpus receiving for the canonical413E10 detail-owner fragment.
include_guard(GLOBAL)
option(SGN_BUILD_SOURCE_PMD_DETAIL_RECEIVING "Build canonical vehicle detail receiving" OFF)
if(SGN_BUILD_SOURCE_PMD_DETAIL_RECEIVING)
  set(SGN_SOURCE_PMD_RETAIL_ROOT "${PROJECT_SOURCE_DIR}/data/retail" CACHE PATH "Actual NEW retail data root")
  set(SGN_SOURCE_PMD_DETAIL_CORPUS_DIR "${PROJECT_SOURCE_DIR}/reports/series2/vehicle-model-detail/final" CACHE PATH "Pinned original model detail corpus directory")
  if(NOT EXISTS "${SGN_SOURCE_PMD_DETAIL_CORPUS_DIR}/model-detail.dat")
    message(FATAL_ERROR "Missing pinned original model detail corpus")
  endif()
  add_executable(source_pmd_detail_oracle "${PROJECT_SOURCE_DIR}/tests/source_pmd_detail_oracle.cpp")
  target_link_libraries(source_pmd_detail_oracle PRIVATE vehicle_model_detail)
  add_executable(source_pmd_detail_contracts "${PROJECT_SOURCE_DIR}/tests/source_pmd_detail_contracts.cpp")
  target_link_libraries(source_pmd_detail_contracts PRIVATE vehicle_model_detail)
  add_test(NAME source_pmd_detail_oracle COMMAND source_pmd_detail_oracle "${SGN_SOURCE_PMD_DETAIL_CORPUS_DIR}/model-detail.dat" "${SGN_SOURCE_PMD_RETAIL_ROOT}")
  foreach(detail_case IN ITEMS footprint aliases lifetime dispatch)
    add_test(NAME detail_${detail_case} COMMAND source_pmd_detail_contracts "${detail_case}" "${SGN_SOURCE_PMD_RETAIL_ROOT}")
  endforeach()
  foreach(rejection IN ITEMS alias_conflict car_id changed_model changed_vehicle empty initial_lod nan_lens short signature too_many trailing zero_lens)
    if(NOT EXISTS "${SGN_SOURCE_PMD_DETAIL_CORPUS_DIR}/reject-${rejection}.dat")
      message(FATAL_ERROR "Missing pinned model detail rejection corpus: ${rejection}")
    endif()
    add_test(NAME detail_reject_${rejection} COMMAND source_pmd_detail_oracle "${SGN_SOURCE_PMD_DETAIL_CORPUS_DIR}/reject-${rejection}.dat" "${SGN_SOURCE_PMD_RETAIL_ROOT}")
    set_tests_properties(detail_reject_${rejection} PROPERTIES WILL_FAIL TRUE)
  endforeach()
endif()
