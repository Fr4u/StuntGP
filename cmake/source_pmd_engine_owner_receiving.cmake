include_guard(GLOBAL)
option(SGN_BUILD_SOURCE_PMD_ENGINE_OWNER_RECEIVING "Build canonical engine registry receiving" OFF)
if(SGN_BUILD_SOURCE_PMD_ENGINE_OWNER_RECEIVING)
  set(SGN_SOURCE_PMD_RETAIL_ROOT "${PROJECT_SOURCE_DIR}/data/retail" CACHE PATH "Actual NEW retail data")
  set(SGN_SOURCE_PMD_ENGINE_CORPUS "${PROJECT_SOURCE_DIR}/reports/contact-work/series2/engine-particles/particles.dat" CACHE FILEPATH "Immutable original engine corpus")
  set(SGN_SOURCE_PMD_ENGINE_OWNER_MAP "${PROJECT_SOURCE_DIR}/reports/platform-work/series6/source-pmd-engine-owner-v1/engine-models.txt" CACHE FILEPATH "Original scenario model mapping")
  set(SGN_SOURCE_PMD_ENGINE_PROBES "${PROJECT_SOURCE_DIR}/reports/qualification-work/series2/engine-particles-review/parent-execution" CACHE PATH "Existing malformed engine probes")
  foreach(reader IN ITEMS source_pmd_engine_owner_oracle source_pmd_engine_owner_contracts)
    add_executable(${reader} "${PROJECT_SOURCE_DIR}/tests/${reader}.cpp")
    target_link_libraries(${reader} PRIVATE contact_vehicle_particles)
  endforeach()
  foreach(input IN ITEMS "${SGN_SOURCE_PMD_ENGINE_CORPUS}" "${SGN_SOURCE_PMD_ENGINE_OWNER_MAP}")
    if(NOT EXISTS "${input}")
      message(FATAL_ERROR "Missing immutable engine receiving input: ${input}")
    endif()
  endforeach()
  add_test(NAME engine_owner_original4096 COMMAND source_pmd_engine_owner_oracle "${SGN_SOURCE_PMD_ENGINE_CORPUS}" "${SGN_SOURCE_PMD_RETAIL_ROOT}" "${SGN_SOURCE_PMD_ENGINE_OWNER_MAP}")
  foreach(probe IN ITEMS truncated trailing schema illegal-mask defined-state)
    if(NOT EXISTS "${SGN_SOURCE_PMD_ENGINE_PROBES}/engine-${probe}.dat")
      message(FATAL_ERROR "Missing existing engine probe: ${probe}")
    endif()
    add_test(NAME engine_owner_probe_${probe} COMMAND source_pmd_engine_owner_oracle "${SGN_SOURCE_PMD_ENGINE_PROBES}/engine-${probe}.dat" "${SGN_SOURCE_PMD_RETAIL_ROOT}" "${SGN_SOURCE_PMD_ENGINE_OWNER_MAP}")
    set_tests_properties(engine_owner_probe_${probe} PROPERTIES WILL_FAIL TRUE)
  endforeach()
  foreach(contract IN ITEMS retail40 owner_current gates lifetime legacy_bound)
    add_test(NAME engine_owner_contract_${contract} COMMAND source_pmd_engine_owner_contracts "${contract}" "${SGN_SOURCE_PMD_RETAIL_ROOT}")
  endforeach()
endif()
