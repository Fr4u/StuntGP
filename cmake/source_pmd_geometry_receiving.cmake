# Private proposal receiving. Main alone compiles/runs and qualifies results.
include_guard(GLOBAL)
option(SGN_BUILD_SOURCE_PMD_GEOMETRY_RECEIVING "Build canonical PMD geometry receiving" OFF)
if(SGN_BUILD_SOURCE_PMD_GEOMETRY_RECEIVING)
  set(SGN_SOURCE_PMD_GEOMETRY_FIXTURES "${PROJECT_SOURCE_DIR}/reports/platform-work/series6/source-pmd-geometry-consumer-v1/fixtures" CACHE PATH "Pinned geometry receiving fixtures")
  set(SGN_SOURCE_PMD_RETAIL_ROOT "${PROJECT_SOURCE_DIR}/data/retail" CACHE PATH "Actual NEW retail data root")
  foreach(fixture IN ITEMS original-matrices.dat static-geometry.dat track-prefix.txt)
    if(NOT EXISTS "${SGN_SOURCE_PMD_GEOMETRY_FIXTURES}/${fixture}")
      message(FATAL_ERROR "Missing sealed canonical PMD geometry fixture: ${fixture}")
    endif()
  endforeach()
  add_executable(source_pmd_geometry_contracts tests/source_pmd_geometry_contracts.cpp)
  target_link_libraries(source_pmd_geometry_contracts PRIVATE source_pmd_geometry)
  foreach(geometry_case IN ITEMS original_matrices static_geometry mutations materials strip_table texture_prefix shared_skin pointer_and_lod bad_geometry free_and_reuse scope metadata_lifetime foreign_thread batching)
    add_test(NAME source_pmd_geometry_${geometry_case} COMMAND source_pmd_geometry_contracts "${geometry_case}" "${SGN_SOURCE_PMD_RETAIL_ROOT}" "${SGN_SOURCE_PMD_GEOMETRY_FIXTURES}")
  endforeach()
  # Existing NEW regressions are distinct from new canonical-source qualification.
  add_executable(source_pmd_geometry_legacy_lod tests/vehicle_lod_skin_contracts.cpp)
  target_link_libraries(source_pmd_geometry_legacy_lod PRIVATE live_scene_geometry)
  add_test(NAME source_pmd_geometry_legacy_lod_regression COMMAND source_pmd_geometry_legacy_lod "${SGN_SOURCE_PMD_RETAIL_ROOT}")
  add_executable(source_pmd_geometry_legacy_matrices tests/renderer_live_model_oracle.cpp)
  target_link_libraries(source_pmd_geometry_legacy_matrices PRIVATE live_scene_geometry)
  add_test(NAME source_pmd_geometry_legacy_matrix_regression COMMAND source_pmd_geometry_legacy_matrices "${SGN_SOURCE_PMD_RETAIL_ROOT}" "${PROJECT_SOURCE_DIR}/reports/contact-work/series2/live-model/models.dat")
  if(TARGET platform_d3d12)
    add_executable(source_pmd_geometry_gpu tests/source_pmd_geometry_gpu.cpp)
    target_link_libraries(source_pmd_geometry_gpu PRIVATE source_pmd_geometry platform_d3d12)
    # Hardware/WARP are explicit receiving commands, never an automatic configure/run.
    # source_pmd_geometry_gpu <retail-root> <output-directory> hardware|warp
  endif()
endif()
