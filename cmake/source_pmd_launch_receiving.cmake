include_guard(GLOBAL)
option(SGN_BUILD_SOURCE_PMD_LAUNCH_RECEIVING "Build full launch owner receiving" OFF)
if(SGN_BUILD_SOURCE_PMD_LAUNCH_RECEIVING)
  set(SGN_SOURCE_PMD_RETAIL_ROOT "${PROJECT_SOURCE_DIR}/data/retail" CACHE PATH "Actual retail data")
  set(SGN_SOURCE_PMD_EFFECTS_CORPUS "${PROJECT_SOURCE_DIR}/reports/camera-work/series2/model-effects/model-effects.dat" CACHE FILEPATH "Immutable effects corpus")
  set(SGN_SOURCE_PMD_LAUNCH_PROBES "${PROJECT_SOURCE_DIR}/reports/platform-work/series6/source-pmd-launch-owner-v1/probes" CACHE PATH "Reader probes")
  set(SGN_SOURCE_PMD_LAUNCH_BASELINE "${PROJECT_SOURCE_DIR}/reports/platform-work/series6/source-pmd-launch-owner-v1/baseline" CACHE PATH "Frozen genuine baseline")
  foreach(reader IN ITEMS source_pmd_launch_oracle source_pmd_launch_contracts)
    add_executable(${reader} "${PROJECT_SOURCE_DIR}/tests/${reader}.cpp")
    target_link_libraries(${reader} PRIVATE vehicle_model_effects)
  endforeach()
  add_test(NAME launch_owner_original256 COMMAND source_pmd_launch_oracle "${SGN_SOURCE_PMD_EFFECTS_CORPUS}" "${SGN_SOURCE_PMD_RETAIL_ROOT}")
  foreach(probe IN ITEMS valid_unavailable valid_disabled valid_active valid_timer0 valid_particle bad_signature truncated trailing empty unknown_operation no_selected nonfinite_turbo nonfinite_strength nonfinite_uv wrong_enabled wrong_unowned wrong_rng valid_particle_w_policy valid_inactive_nan valid_unused_part23 nonfinite_stored_basis)
    if(NOT EXISTS "${SGN_SOURCE_PMD_LAUNCH_PROBES}/${probe}.dat")
      message(FATAL_ERROR "Missing launch probe: ${probe}")
    endif()
    add_test(NAME launch_owner_probe_${probe} COMMAND source_pmd_launch_oracle "${SGN_SOURCE_PMD_LAUNCH_PROBES}/${probe}.dat" "${SGN_SOURCE_PMD_RETAIL_ROOT}")
    if(NOT probe MATCHES "^valid_")
      set_tests_properties(launch_owner_probe_${probe} PROPERTIES WILL_FAIL TRUE)
    endif()
  endforeach()
  foreach(contract IN ITEMS gates timer_capture stored_basis basis_failure first_point_failure second_point_failure captured_head coordinate_order coordinate_prefix coordinate_alias lifetime retail80 second_basis_failure logical_and_alias scalar_boundaries)
    add_test(NAME launch_owner_contract_${contract} COMMAND source_pmd_launch_contracts "${contract}" "${SGN_SOURCE_PMD_RETAIL_ROOT}")
  endforeach()
  add_library(source_pmd_launch_baseline STATIC
    "${SGN_SOURCE_PMD_LAUNCH_BASELINE}/src/assets.cpp"
    "${SGN_SOURCE_PMD_LAUNCH_BASELINE}/src/source_allocation_bank.cpp"
    "${SGN_SOURCE_PMD_LAUNCH_BASELINE}/src/source_pmd_model.cpp"
    "${SGN_SOURCE_PMD_LAUNCH_BASELINE}/src/model_resources.cpp"
    "${SGN_SOURCE_PMD_LAUNCH_BASELINE}/src/vehicle_trails.cpp"
    "${SGN_SOURCE_PMD_LAUNCH_BASELINE}/src/vehicle_model_effects.cpp"
)
  target_include_directories(source_pmd_launch_baseline PUBLIC "${SGN_SOURCE_PMD_LAUNCH_BASELINE}/include")
  target_compile_options(source_pmd_launch_baseline PUBLIC /W4 /WX /permissive- /utf-8 /EHsc /fp:strict /Gy)
  target_link_options(source_pmd_launch_baseline PUBLIC /OPT:REF)
  target_compile_definitions(source_pmd_launch_baseline PUBLIC NOMINMAX WIN32_LEAN_AND_MEAN UNICODE _UNICODE)
  add_executable(source_pmd_launch_eager_probe "${PROJECT_SOURCE_DIR}/tests/source_pmd_launch_eager_probe.cpp")
  target_link_libraries(source_pmd_launch_eager_probe PRIVATE source_pmd_launch_baseline)
  foreach(mode IN ITEMS unavailable disabled)
    add_test(NAME launch_owner_baseline_${mode}_RED COMMAND source_pmd_launch_eager_probe "${mode}" "${SGN_SOURCE_PMD_RETAIL_ROOT}")
    set_tests_properties(launch_owner_baseline_${mode}_RED PROPERTIES WILL_FAIL TRUE)
  endforeach()
  add_executable(source_pmd_launch_frozen_full "${SGN_SOURCE_PMD_LAUNCH_BASELINE}/tests/vehicle_model_effects_oracle.cpp")
  target_link_libraries(source_pmd_launch_frozen_full PRIVATE source_pmd_launch_baseline)
  add_test(NAME launch_owner_frozen_effects1536 COMMAND source_pmd_launch_frozen_full "${SGN_SOURCE_PMD_EFFECTS_CORPUS}")
endif()
