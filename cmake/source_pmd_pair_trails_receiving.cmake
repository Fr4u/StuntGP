include_guard(GLOBAL)
option(SGN_BUILD_SOURCE_PMD_PAIR_TRAILS_RECEIVING "Build paired trail owner receiving" OFF)
if(SGN_BUILD_SOURCE_PMD_PAIR_TRAILS_RECEIVING)
  set(SGN_SOURCE_PMD_RETAIL_ROOT "${PROJECT_SOURCE_DIR}/data/retail" CACHE PATH "Actual retail data")
  set(SGN_SOURCE_PMD_TRAILS_CORPUS "${PROJECT_SOURCE_DIR}/reports/camera-work/series2/trails/vehicle-trails.dat" CACHE FILEPATH "Immutable trails corpus")
  set(SGN_SOURCE_PMD_PAIR_PROBES "${PROJECT_SOURCE_DIR}/reports/platform-work/series6/source-pmd-pair-trails-owner-v1/probes" CACHE PATH "Reader probes")
  set(SGN_SOURCE_PMD_PAIR_BASELINE "${PROJECT_SOURCE_DIR}/reports/platform-work/series6/source-pmd-pair-trails-owner-v1/baseline" CACHE PATH "Frozen baseline RED")
  foreach(reader IN ITEMS source_pmd_pair_trails_oracle source_pmd_pair_trails_contracts)
    add_executable(${reader} "${PROJECT_SOURCE_DIR}/tests/${reader}.cpp")
    target_link_libraries(${reader} PRIVATE vehicle_trails)
  endforeach()
  add_test(NAME pair_trails_owner_original1024 COMMAND source_pmd_pair_trails_oracle "${SGN_SOURCE_PMD_TRAILS_CORPUS}" "${SGN_SOURCE_PMD_RETAIL_ROOT}")
  foreach(probe IN ITEMS valid_early_a valid_early_b valid_active_a valid_active_b valid_policy_expected valid_unused_part23 valid_unused_upw valid_inactive_nonfinite bad_signature truncated trailing empty unknown_entry no_selected nonfinite_basis nonfinite_point nonfinite_projection wrong_counter wrong_unowned wrong_forward_w)
    if(NOT EXISTS "${SGN_SOURCE_PMD_PAIR_PROBES}/${probe}.dat")
      message(FATAL_ERROR "Missing pair trail probe: ${probe}")
    endif()
    add_test(NAME pair_trails_owner_probe_${probe} COMMAND source_pmd_pair_trails_oracle "${SGN_SOURCE_PMD_PAIR_PROBES}/${probe}.dat" "${SGN_SOURCE_PMD_RETAIL_ROOT}")
    if(NOT probe MATCHES "^valid_")
      set_tests_properties(pair_trails_owner_probe_${probe} PROPERTIES WILL_FAIL TRUE)
    endif()
  endforeach()
  foreach(contract IN ITEMS early_green disabled_green active_shadow_green unused_part23 retail40 first_failure second_failure fresh_basis_input audit_ring_projection lifetime unused_up_w)
    add_test(NAME pair_trails_owner_contract_${contract} COMMAND source_pmd_pair_trails_contracts "${contract}" "${SGN_SOURCE_PMD_RETAIL_ROOT}")
  endforeach()
  add_library(source_pmd_pair_baseline STATIC
    "${SGN_SOURCE_PMD_PAIR_BASELINE}/src/assets.cpp"
    "${SGN_SOURCE_PMD_PAIR_BASELINE}/src/source_allocation_bank.cpp"
    "${SGN_SOURCE_PMD_PAIR_BASELINE}/src/source_pmd_model.cpp"
    "${SGN_SOURCE_PMD_PAIR_BASELINE}/src/model_resources.cpp"
    "${SGN_SOURCE_PMD_PAIR_BASELINE}/src/vehicle_trails.cpp"
)
  target_include_directories(source_pmd_pair_baseline PUBLIC "${SGN_SOURCE_PMD_PAIR_BASELINE}/include")
  target_compile_options(source_pmd_pair_baseline PUBLIC /W4 /WX /permissive- /utf-8 /EHsc /fp:strict /Gy)
  target_link_options(source_pmd_pair_baseline PUBLIC /OPT:REF)
  target_compile_definitions(source_pmd_pair_baseline PUBLIC NOMINMAX WIN32_LEAN_AND_MEAN UNICODE _UNICODE)
  add_executable(source_pmd_pair_eager_probe "${PROJECT_SOURCE_DIR}/tests/source_pmd_pair_trails_eager_probe.cpp")
  target_link_libraries(source_pmd_pair_eager_probe PRIVATE source_pmd_pair_baseline)
  foreach(mode IN ITEMS early disabled active)
    foreach(pair IN ITEMS a b)
      add_test(NAME pair_trails_owner_baseline_${mode}_${pair}_RED COMMAND source_pmd_pair_eager_probe "${mode}" "${pair}" "${SGN_SOURCE_PMD_RETAIL_ROOT}")
      set_tests_properties(pair_trails_owner_baseline_${mode}_${pair}_RED PROPERTIES WILL_FAIL TRUE)
    endforeach()
  endforeach()
endif()
