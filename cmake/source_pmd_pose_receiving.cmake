include_guard(GLOBAL)
option(SGN_BUILD_SOURCE_PMD_POSE_RECEIVING "Build canonical full414350 receiving" OFF)
if(SGN_BUILD_SOURCE_PMD_POSE_RECEIVING)
  set(SGN_SOURCE_PMD_RETAIL_ROOT "${PROJECT_SOURCE_DIR}/data/retail" CACHE PATH "Actual NEW retail data root")
  set(SGN_SOURCE_PMD_POSE_CORPUS_DIR "${PROJECT_SOURCE_DIR}/reports/vehicle-work/series6/vehicle-model-prepare-full-v2" CACHE PATH "Pinned original full414350 corpus")
  if(NOT EXISTS "${SGN_SOURCE_PMD_POSE_CORPUS_DIR}/corpus.dat")
    message(FATAL_ERROR "Missing pinned original full414350 corpus")
  endif()
  foreach(reader IN ITEMS source_pmd_pose_oracle source_pmd_pose_contracts)
    add_executable(${reader} "${PROJECT_SOURCE_DIR}/tests/${reader}.cpp")
    target_link_libraries(${reader} PRIVATE vehicle_model_prepare)
  endforeach()
  add_test(NAME source_pmd_pose_original COMMAND source_pmd_pose_oracle "${SGN_SOURCE_PMD_POSE_CORPUS_DIR}/corpus.dat" "${SGN_SOURCE_PMD_RETAIL_ROOT}")
  foreach(pose_case IN ITEMS footprint aliases lifetime dispatch)
    add_test(NAME pose_${pose_case} COMMAND source_pmd_pose_contracts "${pose_case}" "${SGN_SOURCE_PMD_RETAIL_ROOT}")
  endforeach()
  foreach(rejection IN ITEMS vehicle_effect retained_vehicle basis_xyz model_xyz model_retained_scale mask_identity truncated trailing signature)
    if(NOT EXISTS "${SGN_SOURCE_PMD_POSE_CORPUS_DIR}/native-v1/${rejection}.dat")
      message(FATAL_ERROR "Missing full414350 negative corpus: ${rejection}")
    endif()
    add_test(NAME pose_reject_${rejection} COMMAND source_pmd_pose_oracle "${SGN_SOURCE_PMD_POSE_CORPUS_DIR}/native-v1/${rejection}.dat" "${SGN_SOURCE_PMD_RETAIL_ROOT}")
    set_tests_properties(pose_reject_${rejection} PROPERTIES WILL_FAIL TRUE)
  endforeach()
endif()
