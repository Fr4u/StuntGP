include_guard(GLOBAL)
option(SGN_BUILD_SOURCE_PMD_PRESENTATION_RECEIVING "Build standalone canonical presentation receiving" OFF)
if(SGN_BUILD_SOURCE_PMD_PRESENTATION_RECEIVING)
  set(SGN_SOURCE_PMD_RETAIL_ROOT "${PROJECT_SOURCE_DIR}/data/retail" CACHE PATH "Actual retail data")
  set(SGN_SOURCE_PMD_PRESENTATION_CORPUS "${PROJECT_SOURCE_DIR}/reports/camera-work/series2/presentation/vehicle-presentation.dat" CACHE FILEPATH "Immutable presentation corpus")
  set(SGN_SOURCE_PMD_PRESENTATION_PROBES "${PROJECT_SOURCE_DIR}/reports/platform-work/series6/source-pmd-presentation-owner-v1/probes" CACHE PATH "Authored reader controls")
  foreach(reader IN ITEMS source_pmd_presentation_oracle source_pmd_presentation_contracts)
    add_executable(${reader} "${PROJECT_SOURCE_DIR}/tests/${reader}.cpp")
    target_link_libraries(${reader} PRIVATE vehicle_model_detail)
  endforeach()
  add_test(NAME presentation_owner_original256 COMMAND source_pmd_presentation_oracle "${SGN_SOURCE_PMD_PRESENTATION_CORPUS}" "${SGN_SOURCE_PMD_RETAIL_ROOT}")
  foreach(probe IN ITEMS valid_first valid_shared_transform bad_signature truncated trailing empty unknown_entry no_selected invalid_lod invalid_transform wrong_scalar wrong_unowned)
    if(NOT EXISTS "${SGN_SOURCE_PMD_PRESENTATION_PROBES}/${probe}.dat")
      message(FATAL_ERROR "Missing presentation probe: ${probe}")
    endif()
    add_test(NAME presentation_owner_probe_${probe} COMMAND source_pmd_presentation_oracle "${SGN_SOURCE_PMD_PRESENTATION_PROBES}/${probe}.dat" "${SGN_SOURCE_PMD_RETAIL_ROOT}")
    if(NOT probe MATCHES "^valid_")
      set_tests_properties(presentation_owner_probe_${probe} PROPERTIES WILL_FAIL TRUE)
    endif()
  endforeach()
  foreach(contract IN ITEMS retail40 pointer_order alias_current sparse_prefix lifetime)
    add_test(NAME presentation_owner_contract_${contract} COMMAND source_pmd_presentation_contracts "${contract}" "${SGN_SOURCE_PMD_RETAIL_ROOT}")
  endforeach()
endif()
