include_guard(GLOBAL)
option(SGN_BUILD_SOURCE_PMD_ROUTE_LIGHTS_RECEIVING "Build canonical route lights consumer receiving" OFF)
if(SGN_BUILD_SOURCE_PMD_ROUTE_LIGHTS_RECEIVING)
  set(SGN_SOURCE_PMD_RETAIL_ROOT "${PROJECT_SOURCE_DIR}/data/retail" CACHE PATH "Actual NEW retail data")
  set(SGN_SOURCE_PMD_MODEL_EFFECTS_CORPUS "${PROJECT_SOURCE_DIR}/reports/camera-work/series2/model-effects/model-effects.dat" CACHE FILEPATH "Immutable original ModelFX corpus")
  set(SGN_SOURCE_PMD_ROUTE_PROBE_DIR "${PROJECT_SOURCE_DIR}/reports/platform-work/series6/source-pmd-route-lights-owner-v1/probes" CACHE PATH "Authored route reader probes")
  foreach(reader IN ITEMS source_pmd_route_lights_oracle source_pmd_route_lights_contracts)
    add_executable(${reader} "${PROJECT_SOURCE_DIR}/tests/${reader}.cpp")
    target_link_libraries(${reader} PRIVATE vehicle_model_effects)
  endforeach()
  if(NOT EXISTS "${SGN_SOURCE_PMD_MODEL_EFFECTS_CORPUS}")
    message(FATAL_ERROR "Missing immutable ModelFX corpus")
  endif()
  add_test(NAME route_lights_original_projection COMMAND source_pmd_route_lights_oracle "${SGN_SOURCE_PMD_MODEL_EFFECTS_CORPUS}" "${SGN_SOURCE_PMD_RETAIL_ROOT}")
  foreach(probe IN ITEMS valid_transition valid_count_early valid_boundary valid_unused_lod bad_magic truncated trailing empty no_selected invalid_op invalid_map invalid_step zero_divisor wrong_counter wrong_envelope wrong_flag wrong_unowned)
    if(NOT EXISTS "${SGN_SOURCE_PMD_ROUTE_PROBE_DIR}/${probe}.dat")
      message(FATAL_ERROR "Missing authored route probe: ${probe}")
    endif()
    add_test(NAME route_probe_${probe} COMMAND source_pmd_route_lights_oracle "${SGN_SOURCE_PMD_ROUTE_PROBE_DIR}/${probe}.dat" "${SGN_SOURCE_PMD_RETAIL_ROOT}")
    if(NOT probe MATCHES "^valid_")
      set_tests_properties(route_probe_${probe} PROPERTIES WILL_FAIL TRUE)
    endif()
  endforeach()
  foreach(contract IN ITEMS retail40 gates write_order boundaries aliases_lifetime)
    add_test(NAME route_contract_${contract} COMMAND source_pmd_route_lights_contracts "${contract}" "${SGN_SOURCE_PMD_RETAIL_ROOT}")
  endforeach()
endif()
