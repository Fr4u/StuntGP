# Explicit CPU receiving of the canonical Session binding/publication subset.
include_guard(GLOBAL)
option(SGN_BUILD_SOURCE_PMD_SESSION_RECEIVING "Build canonical Session model consumer receiving" OFF)
if(SGN_BUILD_SOURCE_PMD_SESSION_RECEIVING)
  set(SGN_SOURCE_PMD_RETAIL_ROOT "${PROJECT_SOURCE_DIR}/data/retail" CACHE PATH "Actual NEW retail data root")
  set(SGN_SOURCE_PMD_MATRIX_CORPUS "${PROJECT_SOURCE_DIR}/reports/camera-work/series2/model-matrices/matrices.dat" CACHE FILEPATH "Original matrix publication corpus")
  set(SGN_SOURCE_PMD_QUEUE_CORPUS "${PROJECT_SOURCE_DIR}/reports/camera-work/series2/model-draw-queue/qualified/queue.dat" CACHE FILEPATH "Original model queue corpus")
  foreach(corpus IN ITEMS SGN_SOURCE_PMD_MATRIX_CORPUS SGN_SOURCE_PMD_QUEUE_CORPUS)
    if(NOT EXISTS "${${corpus}}")
      message(FATAL_ERROR "Missing pinned canonical consumer corpus: ${corpus}")
    endif()
  endforeach()
  add_executable(source_pmd_published_matrices_oracle tests/source_pmd_published_matrices_oracle.cpp)
  target_link_libraries(source_pmd_published_matrices_oracle PRIVATE retail_model_matrices)
  add_test(NAME source_pmd_session_original_published_matrices COMMAND source_pmd_published_matrices_oracle "${SGN_SOURCE_PMD_MATRIX_CORPUS}" "${SGN_SOURCE_PMD_RETAIL_ROOT}")
  add_executable(source_pmd_draw_queue_oracle tests/source_pmd_draw_queue_oracle.cpp)
  target_link_libraries(source_pmd_draw_queue_oracle PRIVATE retail_model_draw_queue)
  add_test(NAME source_pmd_session_original_draw_queue COMMAND source_pmd_draw_queue_oracle "${SGN_SOURCE_PMD_QUEUE_CORPUS}" "${SGN_SOURCE_PMD_RETAIL_ROOT}")
  add_executable(source_pmd_session_consumers tests/source_pmd_session_consumers.cpp)
  target_link_libraries(source_pmd_session_consumers PRIVATE source_pmd_geometry scene_resources world_model_draw)
  foreach(consumer_case IN ITEMS bindings publication)
    add_test(NAME source_pmd_session_${consumer_case} COMMAND source_pmd_session_consumers "${consumer_case}" "${SGN_SOURCE_PMD_RETAIL_ROOT}")
  endforeach()
  if(TARGET source_pmd_geometry_contracts)
    add_test(NAME source_pmd_session_original_published_views COMMAND source_pmd_geometry_contracts original_published_matrices "${SGN_SOURCE_PMD_RETAIL_ROOT}" "${SGN_SOURCE_PMD_GEOMETRY_FIXTURES}")
  endif()
endif()
