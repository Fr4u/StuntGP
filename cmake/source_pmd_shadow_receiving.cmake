include_guard(GLOBAL)
option(SGN_BUILD_SOURCE_PMD_SHADOW_RECEIVING "Build canonical full41C420 shadow receiving" OFF)
if(SGN_BUILD_SOURCE_PMD_SHADOW_RECEIVING)
  set(SGN_SOURCE_PMD_RETAIL_ROOT "${PROJECT_SOURCE_DIR}/data/retail" CACHE PATH "Actual NEW retail data root")
  set(SGN_SOURCE_PMD_SHADOW_COLD_CORPUS_DIR "${PROJECT_SOURCE_DIR}/reports/series2/shadow-draw/final" CACHE PATH "Pinned shadow cold-template corpus")
  set(SGN_SOURCE_PMD_SHADOW_LIVE_CORPUS_DIR "${PROJECT_SOURCE_DIR}/reports/contact-work/series6/world-template-propagation/shadow-v1" CACHE PATH "Pinned shadow live-template corpus")
  foreach(reader IN ITEMS source_pmd_shadow_oracle source_pmd_shadow_contracts)
    add_executable(${reader} "${PROJECT_SOURCE_DIR}/tests/${reader}.cpp")
    target_link_libraries(${reader} PRIVATE vehicle_shadow_draw)
  endforeach()
  foreach(mode IN ITEMS cold live)
    string(TOUPPER "${mode}" upper_mode)
    set(corpus_dir "${SGN_SOURCE_PMD_SHADOW_${upper_mode}_CORPUS_DIR}")
    if(NOT EXISTS "${corpus_dir}/shadow-draw.dat")
      message(FATAL_ERROR "Missing original shadow corpus: ${mode}")
    endif()
    add_test(NAME shadow_original_${mode} COMMAND source_pmd_shadow_oracle "${mode}" "${corpus_dir}/shadow-draw.dat" "${SGN_SOURCE_PMD_RETAIL_ROOT}")
    set(rejections car_id car_word descriptor_vector empty frame_count lod model_pointer queue_word short signature too_many trailing)
    if(mode STREQUAL "live")
      list(APPEND rejections live_template_1c live_template_4c)
    endif()
    foreach(rejection IN LISTS rejections)
      if(NOT EXISTS "${corpus_dir}/reject-${rejection}.dat")
        message(FATAL_ERROR "Missing shadow rejection corpus: ${mode}/${rejection}")
      endif()
      add_test(NAME shadow_${mode}_reject_${rejection} COMMAND source_pmd_shadow_oracle "${mode}" "${corpus_dir}/reject-${rejection}.dat" "${SGN_SOURCE_PMD_RETAIL_ROOT}")
      set_tests_properties(shadow_${mode}_reject_${rejection} PROPERTIES WILL_FAIL TRUE)
    endforeach()
  endforeach()
  foreach(shadow_case IN ITEMS footprint pointers_and_order lifetime_and_gate dispatch)
    add_test(NAME shadow_${shadow_case} COMMAND source_pmd_shadow_contracts "${shadow_case}" "${SGN_SOURCE_PMD_RETAIL_ROOT}")
  endforeach()
endif()
