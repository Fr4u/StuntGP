include_guard(GLOBAL)
option(SGN_BUILD_SOURCE_PMD_SPEED_TRAIL_RECEIVING "Build canonical speed trail receiving" OFF)
if(SGN_BUILD_SOURCE_PMD_SPEED_TRAIL_RECEIVING)
  set(SGN_SOURCE_PMD_RETAIL_ROOT "${PROJECT_SOURCE_DIR}/data/retail" CACHE PATH "Actual retail data")
  set(SGN_SOURCE_PMD_TRAILS_CORPUS "${PROJECT_SOURCE_DIR}/reports/camera-work/series2/trails/vehicle-trails.dat" CACHE FILEPATH "Immutable trails corpus")
  set(SGN_SOURCE_PMD_SPEED_PROBES "${PROJECT_SOURCE_DIR}/reports/platform-work/series6/source-pmd-speed-trail-owner-v1/probes" CACHE PATH "Reader probes")
  set(SGN_SOURCE_PMD_SPEED_BASELINE "${PROJECT_SOURCE_DIR}/reports/platform-work/series6/source-pmd-speed-trail-owner-v1/baseline" CACHE PATH "Frozen baseline for RED evidence")
  foreach(reader IN ITEMS source_pmd_speed_trail_oracle source_pmd_speed_trail_contracts)
    add_executable(${reader} "${PROJECT_SOURCE_DIR}/tests/${reader}.cpp")
    target_link_libraries(${reader} PRIVATE vehicle_trails)
  endforeach()
  add_test(NAME speed_trail_owner_original512 COMMAND source_pmd_speed_trail_oracle "${SGN_SOURCE_PMD_TRAILS_CORPUS}" "${SGN_SOURCE_PMD_RETAIL_ROOT}")
  foreach(probe IN ITEMS valid_early valid_append valid_policy_expected bad_signature truncated trailing empty unknown_entry no_selected nonfinite_basis wrong_scalar wrong_unowned wrong_forward_w)
    if(NOT EXISTS "${SGN_SOURCE_PMD_SPEED_PROBES}/${probe}.dat")
      message(FATAL_ERROR "Missing speed trail probe: ${probe}")
    endif()
    add_test(NAME speed_trail_owner_probe_${probe} COMMAND source_pmd_speed_trail_oracle "${SGN_SOURCE_PMD_SPEED_PROBES}/${probe}.dat" "${SGN_SOURCE_PMD_RETAIL_ROOT}")
    if(NOT probe MATCHES "^valid_")
      set_tests_properties(speed_trail_owner_probe_${probe} PROPERTIES WILL_FAIL TRUE)
    endif()
  endforeach()
  foreach(contract IN ITEMS early_tick_green reset_slow_green retail40 read_order raw0_alias audit_ring lifetime)
    add_test(NAME speed_trail_owner_contract_${contract} COMMAND source_pmd_speed_trail_contracts "${contract}" "${SGN_SOURCE_PMD_RETAIL_ROOT}")
  endforeach()
  add_library(source_pmd_speed_baseline STATIC
    "${SGN_SOURCE_PMD_SPEED_BASELINE}/src/assets.cpp"
    "${SGN_SOURCE_PMD_SPEED_BASELINE}/src/source_allocation_bank.cpp"
    "${SGN_SOURCE_PMD_SPEED_BASELINE}/src/source_pmd_model.cpp"
    "${SGN_SOURCE_PMD_SPEED_BASELINE}/src/model_resources.cpp"
    "${SGN_SOURCE_PMD_SPEED_BASELINE}/src/vehicle_trails.cpp")
  target_include_directories(source_pmd_speed_baseline PUBLIC "${SGN_SOURCE_PMD_SPEED_BASELINE}/include")
  target_compile_options(source_pmd_speed_baseline PUBLIC /W4 /WX /permissive- /utf-8 /EHsc /fp:strict /Gy)
  target_link_options(source_pmd_speed_baseline PUBLIC /OPT:REF)
  target_compile_definitions(source_pmd_speed_baseline PUBLIC NOMINMAX WIN32_LEAN_AND_MEAN UNICODE _UNICODE)
  add_executable(source_pmd_speed_eager_probe "${PROJECT_SOURCE_DIR}/tests/source_pmd_speed_trail_eager_probe.cpp")
  target_link_libraries(source_pmd_speed_eager_probe PRIVATE source_pmd_speed_baseline)
  foreach(mode IN ITEMS early_tick reset_slow)
    add_test(NAME speed_trail_owner_baseline_${mode}_RED COMMAND source_pmd_speed_eager_probe "${mode}" "${SGN_SOURCE_PMD_RETAIL_ROOT}")
    set_tests_properties(speed_trail_owner_baseline_${mode}_RED PROPERTIES WILL_FAIL TRUE)
  endforeach()
endif()
