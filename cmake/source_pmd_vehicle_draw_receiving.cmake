include_guard(GLOBAL)
option(SGN_BUILD_SOURCE_PMD_VEHICLE_DRAW_RECEIVING "Build canonical418150 and4181E1..4182E3 receiving" OFF)
if(SGN_BUILD_SOURCE_PMD_VEHICLE_DRAW_RECEIVING)
  set(SGN_SOURCE_PMD_RETAIL_ROOT "${PROJECT_SOURCE_DIR}/data/retail" CACHE PATH "Actual NEW retail data root")
  set(SGN_SOURCE_PMD_VEHICLE_DRAW_COLD_CORPUS_DIR "${PROJECT_SOURCE_DIR}/reports/series2/vehicle-draw-pose/final" CACHE PATH "Pinned draw-pose cold corpus")
  set(SGN_SOURCE_PMD_VEHICLE_DRAW_LIVE_CORPUS_DIR "${PROJECT_SOURCE_DIR}/reports/contact-work/series6/world-template-propagation/draw-pose-v1" CACHE PATH "Pinned draw-pose live corpus")
  foreach(reader IN ITEMS source_pmd_vehicle_draw_oracle source_pmd_vehicle_draw_contracts)
    add_executable(${reader} "${PROJECT_SOURCE_DIR}/tests/${reader}.cpp")
    target_link_libraries(${reader} PRIVATE vehicle_draw_pose)
  endforeach()
  foreach(mode IN ITEMS cold live)
    string(TOUPPER "${mode}" upper_mode)
    set(corpus_dir "${SGN_SOURCE_PMD_VEHICLE_DRAW_${upper_mode}_CORPUS_DIR}")
    if(NOT EXISTS "${corpus_dir}/draw-pose.dat")
      message(FATAL_ERROR "Missing original vehicle draw-pose corpus: ${mode}")
    endif()
    add_test(NAME vehicle_draw_original_${mode} COMMAND source_pmd_vehicle_draw_oracle "${mode}" "${corpus_dir}/draw-pose.dat" "${SGN_SOURCE_PMD_RETAIL_ROOT}")
    set(rejections empty short trailing signature too_many changed_pose changed_flag changed_ambient)
    if(mode STREQUAL "live")
      list(APPEND rejections template_1c template_40 template_44 template_48 template_4c)
    endif()
    foreach(rejection IN LISTS rejections)
      if(NOT EXISTS "${corpus_dir}/reject-${rejection}.dat")
        message(FATAL_ERROR "Missing vehicle draw rejection corpus: ${mode}/${rejection}")
      endif()
      add_test(NAME vehicle_draw_${mode}_reject_${rejection} COMMAND source_pmd_vehicle_draw_oracle "${mode}" "${corpus_dir}/reject-${rejection}.dat" "${SGN_SOURCE_PMD_RETAIL_ROOT}")
      set_tests_properties(vehicle_draw_${mode}_reject_${rejection} PROPERTIES WILL_FAIL TRUE)
    endforeach()
  endforeach()
  foreach(contract IN ITEMS footprint order lifetime dispatch)
    add_test(NAME vehicle_draw_${contract} COMMAND source_pmd_vehicle_draw_contracts "${contract}" "${SGN_SOURCE_PMD_RETAIL_ROOT}")
  endforeach()
endif()
